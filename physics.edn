;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; ISCO 2423, personnel and careers professionals. The README calls this pure-cognitive work with no robotics
;; gate; blueprint.edn nevertheless declares :itonami.blueprint/robotics true.
;; The physical work declared here is the handling the occupation itself
;; entails (ASSUMPTION, not stated in the README): lifting personnel-file boxes onto the HR records shelf, and delivering onboarding kits (laptop, badge, paperwork) to new hires' desks.
;; Replace with the README premise once one is written.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-2423"
 :cases
 [{:id :personnel-file-box-to-shelf
   :kind :manipulator
   :procedure "arm lifts a box of personnel files from the intake cart onto the HR records shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 3.5 :m2-kg 2.5
            :from [0.55 -0.10] :to [0.20 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 3.0 5.0 7.0 9.0]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a light collaborative arm (~5 kg class)"}
   :boundary {:lo 0.1 :hi 30.0}}
  {:id :onboarding-kit-delivery
   :kind :transport
   :procedure "office AMR delivers onboarding kits (laptop, badge, paperwork) from HR to new hires' desks"
   :params {:mass-kg 30.0 :payload-kg 12.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.7 :drive-force-n 60.0 :crr 0.02
            :cog-height-m 0.50 :support-half-length-m 0.22}
   :sweep {:param :distance-m :values [20.0 40.0 60.0 80.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 70.0 :basis "estimate: each desk delivery within 70 s so a cohort of new hires is equipped inside the first onboarding session"}
   :boundary {:lo 5.0 :hi 250.0}}]}
